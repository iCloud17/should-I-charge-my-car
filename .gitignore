# macOS
.DS_Store

# Node (only used by optional seed scripts)
node_modules/
npm-debug.log*
.env
.env.local

# Editor
.vscode/*
!.vscode/extensions.json

# Logs
*.log

# Local browser-testing artifacts
.playwright-mcp/
/*.png
!/og-image.png

# Scratch space for local runs: backups, probe scripts, server logs, screenshots.
# Everything temporary belongs here rather than in /tmp, so it is visible and
# can be cleared in one go.
tmp/

# Seed script cache
scripts/.vehicles.cache.csv

# Local design notes
DESIGN.md

# Local tooling under .github (keep only the Pages deploy workflow)
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/deploy.yml

# AI-agent workflow tooling (local only)
.squad/
.squad-workstream
.gitattributes
.mcp.json
.copilot/
